# mlx-kv-server environment variables (reference only).
# The server reads its configuration from a TOML file, not from env vars.
# These variables document what values to put in config.toml.

MLX_KV_SOCKET_PATH=/tmp/mlx-kv-server.sock
MLX_KV_MODEL_NAME=mlx-community/Mistral-7B-Instruct-v0.3-4bit
MLX_KV_MAX_TOKENS=512
MLX_KV_TEMPERATURE=0.0
